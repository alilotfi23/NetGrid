[TEMPLATE]
# Frontend dev environment (copy to .env.local and fill in)
#
# The dashboard pages are server components: they fetch the FastAPI backend
# server-side using the admin session cookie (HttpOnly), so the access token
# never reaches the browser. Sign in at /login to start a session.

# Where the FastAPI backend lives. docker-compose overrides this to
# http://backend:8000 inside the compose network.
BACKEND_URL=http://localhost:8000

# No token variables needed — sessions are minted by the login flow at /login
# (seeded dev credentials: superadmin / netgrid-admin).
