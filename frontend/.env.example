# Frontend dev environment (copy to .env.local and fill in)
#
# The stats card is a server component: it fetches the FastAPI backend
# server-side with a bearer token, so these are never exposed to the browser.

# Where the FastAPI backend lives. docker-compose overrides this to
# http://backend:8000 inside the compose network.
BACKEND_URL=http://localhost:8000

# Admin access token for the server-side fetch. Obtain one from the backend:
#   curl -s -X POST http://localhost:8000/api/v1/auth/login \
#     -H "Content-Type: application/json" \
#     -d '{"username":"superadmin","password":"netgrid-admin"}'
# -> use the "access_token" value (15-minute TTL; re-issue as needed).
# A real admin login flow lands with Phase 12.
NETGRID_DEMO_TOKEN=
